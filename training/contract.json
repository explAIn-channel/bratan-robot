    "history_maximum_gap_s": 0.75,
    "history_selection": "latest_sample_not_after_target",
    "history_warmup_s": 2.0,
    "laser_yaw_rad": 1.5062,
    "range_encoding": "log",
    "path_scale_m": 2.0,
    "path_sampling": "uniform_near_arc_length_v1",
    "path_lookahead_m": 1.0,
    "path_source": "causal_local_map_replan_v1",
    "linear_velocity_scale_mps": 0.5,
    "angular_velocity_scale_radps": 2.0
  },
  "geometry": {
    "frame": "base_link",
    "footprint_m": [
